# =========================================================
# Resume Matching Agent - Environment variables
# Copy this file to `.env` and fill in your own values.
# =========================================================

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys
# Replace the value below with your own key in your local `.env` (NEVER commit
# a real key — it will be picked up by GitHub's secret scanning).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OWN_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free, capable open-weight model on OpenRouter
MODEL=openai/gpt-oss-120b:free

# (Optional) headers OpenRouter uses for analytics / leaderboard
OPENROUTER_REFERRER=https://github.com/your-username/resume-matching-agent
OPENROUTER_TITLE=Resume Matching Agent

# --- Embeddings ---
# Local SentenceTransformer model (no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
# Path where FAISS index + metadata are persisted
VECTORSTORE_DIR=./.vectorstore

# --- Data ---
RESUMES_DIR=./data/resumes
JDS_DIR=./data/sample_jds

# --- Logging ---
LOG_LEVEL=INFO
